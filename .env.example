APP_NAME=Shaky Razor AI Receptionist
APP_ENV=development
BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./shop_name.db

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15555555555
OWNER_PHONE_NUMBER=+15555555556
SHOP_BOOKING_LINK=https://example.com/book
SHOP_NAME= Shop Name
SHOP_HOURS=(example: Mon-Fri 9:00 AM - 5:00 PM)
SHOP_ADDRESS= City, State, Zip Code

OPENAI_API_KEY=your_openai_api_key

DASHBOARD_KEY=set_to_a_long_random_string
# Separate from DASHBOARD_KEY on purpose — signs session cookies. If
# DASHBOARD_KEY ever leaks again, a distinct SESSION_SECRET means the leak
# can't be used to forge session cookies directly. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=set_to_a_different_long_random_string
# Separate again from both of the above — signs /billing/checkout links so
# business_id and plan can't be edited in the URL bar after the link is
# generated. Same generator command as above works.
CHECKOUT_LINK_SECRET=set_to_yet_another_different_long_random_string

USE_ELEVENLABS=false
ELEVENLABS_API_KEY=sk_your_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
ELEVENLABS_MODEL=eleven_turbo_v2_5